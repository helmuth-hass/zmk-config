#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Layout do sistema operacional: Português (Brasil ABNT2).
 *
 * O ZMK envia códigos de posição (HID), então os nomes dos códigos abaixo
 * seguem o layout US e o sistema os traduz para ABNT2. Equivalências usadas:
 *
 *   caractere   código ZMK         observação
 *   ---------   ----------------   ----------------------------------
 *   ;           FSLH               (tecla "/" do US)
 *   '           GRAVE              (tecla "`" do US)
 *   /           RA(Q)              (AltGr + Q)
 *   ç           SEMI               (tecla ";" do US)
 *   [  ]        RBKT  BSLH
 *   {  }        LS(RBKT)  LS(BSLH)
 *   \  |        NUBS  LS(NUBS)
 *   ´           LBKT               tecla morta: ´ + vogal = á é í ó ú
 *   ~           SQT                tecla morta: ~ + vogal = ã õ
 *   ^           LS(SQT)            tecla morta: ^ + vogal = â ê ô
 *   `           LS(LBKT)           tecla morta
 *
 * Teclas mortas: para escrever o próprio símbolo (~ ^ ` ´) aperte Espaço depois.
 */

/ {
        behaviors {
                // Toque: C. Segurar: ç (tecla ";" do US = ç no ABNT2).
                // Uso: &cedilla <segurar> <toque>
                cedilla: cedilla {
                        compatible = "zmk,behavior-hold-tap";
                        label = "CEDILLA";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <200>;
                        bindings = <&kp>, <&kp>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "0";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  | C/ç |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E          &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D          &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp FSLH &kp GRAVE
   &kp LSHFT &kp Z &kp X &cedilla SEMI C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp RA(Q) &kp ESC
                  &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
                        display-name = "1";
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | DEL  |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |  ´  |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0   &kp DEL
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp LBKT &trans
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans   &trans
                                    &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
                        display-name = "2";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp LS(SQT) &kp AMPS  &kp ASTRK &kp LPAR      &kp RPAR      &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS   &kp EQUAL &kp RBKT  &kp BSLH      &kp NUBS      &kp LS(LBKT)
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER   &kp PLUS  &kp LS(RBKT) &kp LS(BSLH) &kp LS(NUBS) &kp SQT
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                function_layer {
                        display-name = "FN";
// -----------------------------------------------------------------------------------------
// |      | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 | DEL  |
// |      | F11 | F12 |     |     |     |   |     |     |     |     |     |      |
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
                        bindings = <
   &trans &kp F1  &kp F2  &kp F3 &kp F4 &kp F5   &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp DEL
   &trans &kp F11 &kp F12 &trans &trans &trans   &trans &trans &trans &trans &trans  &trans
   &trans &trans  &trans  &trans &trans &trans   &trans &trans &trans &trans &trans  &trans
                          &trans &trans &trans   &trans &trans &trans
                        >;
                };
        };

        // Segurando Lower (1) + Raise (2) ao mesmo tempo ativa a camada Function (3)
        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };
};
